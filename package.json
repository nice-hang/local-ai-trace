{
  "name": "local-ai-trace",
  "version": "0.1.0",
  "description": "Local LLM tracing server with OpenAI-compatible API",
  "type": "module",
  "bin": {
    "lat": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "cd client && npm run build",
    "dev": "tsx watch src/index.ts start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "commander": "^12.0.0",
    "conf": "^13.0.0",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.0",
    "node-llama-cpp": "^3.18.1",
    "openai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
